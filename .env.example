# ════════════════════════════════════════════════════════
# Royal Jubilant Real Estate — Environment Variables
# ════════════════════════════════════════════════════════
# 
# Copy this file to .env and fill in your values.
# DO NOT commit real .env to GitHub (it's gitignored).

# ─── Database (Supabase PostgreSQL) ─────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── Authentication ─────────────────────────────────────
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here

# Local development: http://localhost:3000
# Production: https://www.royaljubilant.com
NEXTAUTH_URL=http://localhost:3000

# ─── Server Config ──────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Supabase Storage (for image uploads) ───────────────
# Get these from: Supabase Dashboard → Project Settings → API
# SUPABASE_URL and SUPABASE_API_KEY are optional in .env
# (upload routes have hardcoded keys for reliability)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_API_KEY=your-service-role-key

# ─── AI Provider (RJ AI Concierge) ──────────────────────
# Which provider to use for the RJ AI chatbot. Options:
#   gemini   — Google Gemini (recommended, free tier generous)
#   glm      — Z.ai GLM-4 (default, legacy)
#   openai   — OpenAI GPT-4 (requires OPENAI_API_KEY + implementation)
#   claude   — Anthropic Claude (requires ANTHROPIC_API_KEY + implementation)
#   deepseek — DeepSeek (requires DEEPSEEK_API_KEY + implementation)
#   qwen     — Alibaba Qwen (requires DASHSCOPE_API_KEY + implementation)
#
# If AI_PROVIDER is not set, the system auto-detects:
#   - If GEMINI_API_KEY is set → uses Gemini
#   - Otherwise → uses GLM (legacy default)
# AI_PROVIDER=gemini

# Google Gemini API key — get from https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1500 requests/day (gemini-2.0-flash)
# GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model — defaults to 'gemini-2.0-flash' (fast + cheap)
# Other options: 'gemini-2.5-flash', 'gemini-2.5-pro', 'gemini-1.5-pro'
# GEMINI_MODEL=gemini-2.0-flash
