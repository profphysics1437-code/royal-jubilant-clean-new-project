# ════════════════════════════════════════════════════════
# Royal Jubilant Real Estate — Environment Variables
# ════════════════════════════════════════════════════════
# 
# Copy this file to .env and fill in your values.
# DO NOT commit real .env to GitHub (it's gitignored).

# ─── Database (Supabase PostgreSQL) ─────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── Authentication ─────────────────────────────────────
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here

# Local development: http://localhost:3000
# Production: https://www.royaljubilant.com
NEXTAUTH_URL=http://localhost:3000

# ─── Server Config ──────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Supabase Storage (for image uploads) ───────────────
# Get these from: Supabase Dashboard → Project Settings → API
# SUPABASE_URL and SUPABASE_API_KEY are optional in .env
# (upload routes have hardcoded keys for reliability)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_API_KEY=your-service-role-key
