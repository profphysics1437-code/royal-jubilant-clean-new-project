// ════════════════════════════════════════════════════════
// Royal Jubilant Real Estate — Clean Production Schema
// Database: PostgreSQL (Supabase)
// ════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identity & RBAC ────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  phone         String?
  role          String   @default("customer") // admin | agent | customer
  passwordHash  String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  properties    Property[]
  leads         Lead[]
}

// ─── Properties ─────────────────────────────────────────

model Property {
  id              String   @id @default(cuid())
  reference       String   @unique
  title           String
  slug            String   @unique
  status          String   // sale | rent | off-plan
  type            String   // Villa | Apartment | Penthouse | etc
  category        String?  // Residential | Commercial
  community       String
  subCommunity    String?
  price           Float
  pricePerSqft    Float?
  rentFrequency   String?  // yearly | monthly | weekly | daily
  bedrooms        Int      @default(0)
  bathrooms       Int      @default(0)
  area            Float    @default(0)
  areaUnit        String   @default("sqft")
  parking         Int      @default(0)
  furnished       Boolean  @default(false)
  description     String
  images          String   @default("[]") // JSON array of URLs
  videoUrl        String?
  amenities       String   @default("[]") // JSON array
  features        String   @default("[]") // JSON array
  reraNumber      String?
  developer       String?
  completionStatus String?
  locationAddress String?
  locationLat     Float?
  locationLng     Float?
  featured        Boolean  @default(false)
  isLatest        Boolean  @default(true)
  isLuxury        Boolean  @default(false)
  published       Boolean  @default(false) // Admin approval
  views           Int      @default(0)
  agentId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent           User?    @relation(fields: [agentId], references: [id])
  leads           Lead[]
}

// ─── Agents ─────────────────────────────────────────────

model Agent {
  id               String   @id @default(cuid())
  userId           String   @unique
  name             String
  title            String?
  photo            String?
  phone            String?
  whatsapp         String?
  email            String?
  languages        String   @default("[]")
  specializations  String   @default("[]")
  communities      String   @default("[]")
  biography        String?
  rating           Float    @default(5.0)
  reviewsCount     Int      @default(0)
  activeListings   Int      @default(0)
  soldProperties   Int      @default(0)
  experienceYears  Int      @default(0)
  order            Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Leads ──────────────────────────────────────────────

model Lead {
  id          String   @id @default(cuid())
  name        String?
  email       String?
  phone       String?
  message     String?
  propertyId  String?
  agentId     String?
  userId      String?
  status      String   @default("new") // new | contacted | closed
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property    Property? @relation(fields: [propertyId], references: [id])
  agent       User?     @relation(fields: [agentId], references: [id])
}

// ─── Content Management ─────────────────────────────────

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String?
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        String   @id @default(cuid())
  label     String
  url       String   @default("")
  view      String?
  desc      String?
  badge     String?
  parentId  String?
  order     Int      @default(0)
  icon      String?
  menu      String   @default("main")
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  location  String?
  avatar    String?
  rating    Int      @default(5)
  quote     String
  service   String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Community {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  hero      String?
  overview  String?
  lifestyle String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Developer {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  description String?
  website   String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  body        String
  coverImage  String?
  category    String?
  author      String?
  published   Boolean  @default(true)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id        String   @id @default(cuid())
  heading1  String?
  heading2  String?
  heading3  String?
  subtitle  String?
  bgImage   String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id          String   @id @default(cuid())
  title       String
  advisor     String?
  role        String?
  category    String?
  duration    String?
  thumbnail   String?
  description String?
  videoUrl    String?
  youtubeUrl  String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Award {
  id          String   @id @default(cuid())
  title       String
  organization String?
  year        String?
  description String?
  image       String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Popup {
  id          String   @id @default(cuid())
  title       String?
  content     String?
  type        String?
  trigger     String?
  delaySeconds Int     @default(5)
  position    String?
  imageUrl    String?
  buttonText  String?
  buttonLink  String?
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SeoMeta {
  id              String   @id @default(cuid())
  pageSlug        String   @unique
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LandingPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  seoTitle    String?
  seoDescription String?
  content     String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaFile {
  id        String   @id @default(cuid())
  filename  String
  url       String
  type      String
  folder    String   @default("general")
  size      Int      @default(0)
  altTag    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
